---
import PostCard from './PostCard.astro'
import type { Post } from '../lib/posts'

interface Props {
  posts: Post[]
  /** 卡片编号的起始偏移，分页时保持连续 */
  offset?: number
}

const { posts, offset = 0 } = Astro.props
---

<div class="card-list">
  {posts.map((p, i) => <PostCard post={p} index={offset + i} />)}
</div>
