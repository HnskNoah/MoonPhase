---
import { readFileSync } from 'node:fs'
import { createHash } from 'node:crypto'
import { fileURLToPath } from 'node:url'
import '../styles/main.css'
import { getImage } from 'astro:assets'
import abyss from '../assets/abyss.jpg'
import { config } from '../consts'
import { u, fmtDateLatin } from '../lib/site'

/**
 * favicon 在 public/ 下是原样拷贝，没有内容哈希，URL 一成不变 —— 换图标会被
 * 浏览器的 favicon 缓存黏好几天。这里按文件内容算个短哈希当查询参数：
 * 图标一改 URL 就跟着改，不用记得手动去 bump 版本号。
 */
const faviconV = createHash('sha256')
  .update(readFileSync(fileURLToPath(new URL('../../public/assets/favicon.svg', import.meta.url))))
  .digest('hex')
  .slice(0, 8)

interface Props {
  title?: string
  description?: string
  /** 当前页面路径，用于 canonical 与 og:url */
  path?: string
  /** 高亮的导航项 href */
  active?: string
  bodyClass?: string
  postsCount?: number
}

const {
  title: pageTitle,
  description = config.description,
  path = '/',
  active = '/',
  bodyClass = '',
  postsCount = 0,
} = Astro.props

const fullTitle = pageTitle ? `${pageTitle} · ${config.title}` : `${config.latinTitle} · ${config.title}`
const canonical = new URL(u(path), Astro.site).href

const isOn = (href: string) => (href === '/' ? active === '/' : active === href || active.startsWith(href))
const navItems = config.nav.map((item) => ({ ...item, href: u(item.href), on: isOn(item.href) }))

/**
 * 背景圆盘用的照片。不能在 CSS 里写 url('../assets/abyss.jpg')：
 * 那张图被 astro:assets 接管后 Vite 只输出优化过的 webp，CSS 里的原图路径会 404。
 */
const discImg = await getImage({ src: abyss, width: 1000, format: 'webp' })
---

<!doctype html>
<html lang={config.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={config.author} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#04101f" />
    <link rel="icon" href={`${u('/assets/favicon.svg')}?v=${faviconV}`} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={config.title} href={u('/rss.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,600;0,800;0,900;1,400;1,600;1,800;1,900&family=JetBrains+Mono:wght@400;700&family=Noto+Sans+SC:wght@400;500;700;900&display=swap"
    />
    <!-- 先落主题再绘制，避免夜间模式下闪一下白 -->
    <script is:inline>
      ;(function () {
        try {
          var saved = localStorage.getItem('p3-night')
          var night = saved === null ? window.matchMedia('(prefers-color-scheme: dark)').matches : saved === '1'
          if (night) document.documentElement.setAttribute('data-theme', 'night')
        } catch (e) {
          /* 拿不到 localStorage 就用默认浅色 */
        }
      })()
    </script>
  </head>

  <body class={bodyClass} data-posts={postsCount}>
    <div class="sea" style={`--sea-disc-img: url('${discImg.src}')`} aria-hidden="true">
      <div class="sea-rays"></div>
      <div class="sea-vignette"></div>
      <div class="sea-grain"></div>
    </div>

    <!-- 出血到画面外的巨型裁切字母，当水印用 -->
    <div class="glyphs" aria-hidden="true">
      <b>{config.latinTitle}</b>
    </div>

    <a class="skip" href="#main">跳到正文</a>

    <header class="site-head">
      <a class="brand" href={u('/')}>
        <svg class="brand-moon" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
          <defs>
            <clipPath id="bm-clip">
              <circle cx="16" cy="16" r="10.5"></circle>
            </clipPath>
            <linearGradient id="bm-sky" x1="0" y1="0" x2="0" y2="1">
              <stop class="bm-stop-a" offset="0"></stop>
              <stop class="bm-stop-b" offset="1"></stop>
            </linearGradient>
          </defs>
          <circle class="bm-ring" cx="16" cy="16" r="14.6"></circle>
          <circle class="bm-disc" cx="16" cy="16" r="10.5" fill="url(#bm-sky)"></circle>
          <g clip-path="url(#bm-clip)">
            <circle class="bm-shadow" id="bm-shadow" cx="16" cy="16" r="10.5"></circle>
          </g>
        </svg>
        <span class="brand-text">
          <b>{config.latinTitle}</b>
          <i>{config.title}</i>
        </span>
      </a>

      <nav id="site-nav" class="site-nav" aria-label="主导航">
        {
          navItems.map((item) => (
            <a class:list={['nav-item', { 'is-on': item.on }]} href={item.href}>
              <>
                <span class="nav-latin">{item.latin}</span>
                <span class="nav-label">{item.label}</span>
              </>
            </a>
          ))
        }
      </nav>

      <div class="head-tools">
        <time class="dark-clock" id="dark-clock" title="Dark Hour 时钟">--:--</time>
        <button
          class="night-btn"
          id="night-toggle"
          type="button"
          aria-pressed="false"
          aria-label="切换夜间模式"
          title="当前：浅色模式"
        >
          <span class="nb-disc" aria-hidden="true"></span>
          <span class="nb-label" aria-hidden="true">
            <span class="nb-light">LIGHT</span>
            <span class="nb-night">NIGHT</span>
          </span>
        </button>
        <button class="menu-btn" id="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
          MENU
        </button>
      </div>
    </header>

    <div class="moon-progress" aria-hidden="true">
      <span class="mp-label">MOON</span>
      <!-- 外圈单独包一层：.moon-disc 要 overflow:hidden 裁月影，圈挂不到它自己身上 -->
      <span class="moon-halo">
        <span class="moon-disc">
          <i class="moon-shadow"></i>
        </span>
      </span>
      <span class="mp-track">
        <i class="mp-fill"></i>
      </span>
    </div>

    <main id="main" class="site-main">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="foot-inner">
        <div class="foot-mori">
          <span class="foot-rule"></span>
          <span class="foot-mori-text">MEMENTO&nbsp;MORI</span>
          <span class="foot-rule"></span>
        </div>
        <div class="foot-cols">
          <p class="foot-copy">
            © {new Date().getFullYear()}
            {config.author} · 记住终将逝去的东西
          </p>
          <p class="foot-links">
            {
              config.social.map((s) => (
                <a href={u(s.url)} rel="me">
                  {s.label}
                </a>
              ))
            }
          </p>
          <p class="foot-meta">
            <span>{postsCount} 条记录</span> · <span>PHASE {String(postsCount).padStart(3, '0')}</span> ·
            <span>{fmtDateLatin(new Date())}</span>
          </p>
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/client.ts'
    </script>
  </body>
</html>
